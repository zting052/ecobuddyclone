# Docker Compose Environment Variables
# Copy this file to .env.docker and customize as needed

# PostgreSQL Database Configuration
POSTGRES_DB=energyteen
POSTGRES_USER=ecobuddy
POSTGRES_PASSWORD=ecobuddy_password_change_in_production

# Backend Configuration
JWT_SECRET=your-secret-key-here-change-in-production
NODE_ENV=production
BACKEND_PORT=3001

# Frontend Configuration
FRONTEND_PORT=80
VITE_API_URL=http://localhost:3001/api

# Database Connection (automatically set by docker-compose)
# DATABASE_URL=postgresql://ecobuddy:ecobuddy_password_change_in_production@db:5432/energyteen
